<mxfile host="app.diagrams.net"><diagram name="1.7.2.2"><mxGraphModel page="1" pageWidth="1020" pageHeight="816"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Вопрос 1.7.2.2 · блок 1.7.2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#8aa1b5;fontSize=17;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="960" height="55" as="geometry"/></mxCell><mxCell id="question" value="Какие положения соответствуют панентеизму в изложении лекции?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#8aa1b5;fontSize=17;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="89" width="960" height="90" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ Всё существующее пребывает в Боге" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#8aa1b5;fontSize=17;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="193" width="960" height="72" as="geometry"/></mxCell><mxCell id="choice_2" value="✓ Бог остаётся Личностью и не растворяется в мире" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#8aa1b5;fontSize=17;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="279" width="960" height="72" as="geometry"/></mxCell><mxCell id="choice_3" value="Бог полностью тождествен материальному космосу" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#8aa1b5;fontSize=17;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="365" width="960" height="72" as="geometry"/></mxCell><mxCell id="choice_4" value="Бог создал мир и исключил всякое дальнейшее отношение к нему" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#8aa1b5;fontSize=17;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="451" width="960" height="72" as="geometry"/></mxCell><mxCell id="explanation" value="Абзац 82 определяет панентеизм Краузе: всё существующее пребывает в Боге, однако Бог остаётся Личностью и не растворяется в мире. Это не тождество Бога и космоса и не деизм." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#8aa1b5;fontSize=17;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="537" width="960" height="105" as="geometry"/></mxCell><mxCell id="difficulty" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#8aa1b5;fontSize=17;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="656" width="960" height="56" as="geometry"/></mxCell><mxCell id="reference" value="82, 86–88" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#8aa1b5;fontSize=17;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="726" width="960" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>