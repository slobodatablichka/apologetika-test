<mxfile host="app.diagrams.net"><diagram name="1.9.1.1"><mxGraphModel page="1" pageWidth="1020" pageHeight="902"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Вопрос 1.9.1.1 · блок 1.9.1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#8aa1b5;fontSize=17;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="960" height="55" as="geometry"/></mxCell><mxCell id="question" value="Какие четыре направления апологетики названы преподавателем?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#8aa1b5;fontSize=17;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="89" width="960" height="90" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ Богословское" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#8aa1b5;fontSize=17;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="193" width="960" height="72" as="geometry"/></mxCell><mxCell id="choice_2" value="✓ Историческое" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#8aa1b5;fontSize=17;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="279" width="960" height="72" as="geometry"/></mxCell><mxCell id="choice_3" value="✓ Философское" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#8aa1b5;fontSize=17;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="365" width="960" height="72" as="geometry"/></mxCell><mxCell id="choice_4" value="✓ Естественнонаучное" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#8aa1b5;fontSize=17;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="451" width="960" height="72" as="geometry"/></mxCell><mxCell id="choice_5" value="Финансовое" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#8aa1b5;fontSize=17;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="537" width="960" height="72" as="geometry"/></mxCell><mxCell id="explanation" value="§1.9 выд