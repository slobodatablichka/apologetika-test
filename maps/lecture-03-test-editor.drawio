12;" vertex="1" parent="1"><mxGeometry x="30" y="657" width="1050" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.4.1.2" name="3.4.1.2"><mxGraphModel dx="1280" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="question" value="Какую роль в изучении природы отводил математике Роджер Бэкон?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1050" height="82" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ Основу наук о природе" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_2" value="Вспомогательный язык описания готовых наблюдений" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_3" value="Раздел логики и риторики" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="1050" height="67" as="geometry"/></mxCell><mxCell id="explanation" value="В лекции прямо сказано, что он считал математику основой наук о природе." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4db;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="1050" height="99" as="geometry"/></mxCell><mxCell id="difficulty" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf9ed;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="517" width="1050" height="47" as="geometry"/></mxCell><mxCell id="reference" value="4 курс ТЕМА 3апологетика.docx — §3.4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2eff9;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="577" width="1050" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.4.1.3" name="3.4.1.3"><mxGraphModel dx="1280" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="question" value="Какие дисциплины относятся к формальным наукам в одной из описанных классификаций?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1050" height="82" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ Логика" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_2" value="✓ Математика" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_3" value="✓ Информатика" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_4" value="Теоретическая физика" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="1050" height="67" as="geometry"/></mxCell><mxCell id="explanation" value="В §3.4 к формальным наукам относят математику, логику, информатику и кибернетику. Теоретическая физика остаётся естественной наукой, хотя использует формальный аппарат." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4db;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="485" width="1050" height="99" as="geometry"/></mxCell><mxCell id="difficulty" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf9ed;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="597" width="1050" height="47" as="geometry"/></mxCell><mxCell id="reference" value="4 курс ТЕМА 3апологетика.docx — §3.4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2eff9;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="657" width="1050" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.5.1.1" name="3.5.1.1"><mxGraphModel dx="1280" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="question" value="Какой класс наук непосредственно изучает явления и законы природы?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1050" height="82" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ Естественные науки" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_2" value="Технические науки" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_3" value="Антропологи