<mxfile host="app.diagrams.net" modified="2026-10-20T00:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="3.1.1.1" name="3.1.1.1"><mxGraphModel dx="1280" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="question" value="С каким мировоззрением историки и философы науки связывают одну из предпосылок становления новоевропейского естествознания?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1050" height="82" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ С христианским представлением о разумно устроенном мире" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_2" value="С представлением о самодостаточности античной натурфилософии" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_3" value="С просветительским требованием отделения исследования природы от богословия" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="1050" height="67" as="geometry"/></mxCell><mxCell id="explanation" value="В исходном материале подчёркивается христианское представление о разумности мироздания как один из истоков науки. Это историко-философская интерпретация, а не единственное объяснение её становления." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4db;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="1050" height="99" as="geometry"/></mxCell><mxCell id="difficulty" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf9ed;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="517" width="1050" height="47" as="geometry"/></mxCell><mxCell id="reference" value="4 курс ТЕМА 3апологетика.docx — §3.1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2eff9;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="577" width="1050" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.1.1.2" name="3.1.1.2"><mxGraphModel dx="1280" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="question" value="В каком веке научный метод обрёл статус самостоятельного основания особой области духовной культуры?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1050" height="82" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ XVII век" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_2" value="XVI век" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_3" value="XVIII век" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="1050" height="67" as="geometry"/></mxCell><mxCell id="explanation" value="В тексте самостоятельное значение научного метода связывается с XVII веком." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4db;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="1050" height="99" as="geometry"/></mxCell><mxCell id="difficulty" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf9ed;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="517" width="1050" height="47" as="geometry"/></mxCell><mxCell id="reference" value="4 курс ТЕМА 3апологетика.docx — §3.1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2eff9;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="577" width="1050" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.1.1.3" name="3.1.1.3"><mxGraphModel dx="1280" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="question" value="Кто из учёных средневекового Оксфорда участвовал в пересмотре аристотелевских представлений о природе?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1050" height="82" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ Роберт Гроссетесте" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_2" value="✓ Роджер Бэкон" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_3" value="Фома Аквинский" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_4" value="Уильям Оккам" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="1050" height="67" as="geometry"/></mxCell><mxCell id="explanation" value="В разделе 3.1 названы Роберт Гроссетесте и Роджер Бэкон; Фома Аквинский представляет обсуждаемую аристотелевскую традицию, а Оккам — другой этап средневековой мысли." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4db;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="485" width="1050" height="99" as="geometry"/></mxCell><mxCell id="difficulty" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf9ed;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="597" width="1050" height="47" as="geometry"/></mxCell><mxCell id="reference" value="4 курс ТЕМА 3апологетика.docx — §3.1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2eff9;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="657" width="1050" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.2.1.1" name="3.2.1.1"><mxGraphModel dx="1280" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="question" value="К какой области культуры относится научное знание как совокупность идей, теорий и методов?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1050" height="82" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ К духовной культуре" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_2" value="К материальной культуре" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_3" value="К социальной культуре" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="1050" height="67" as="geometry"/></mxCell><mxCell id="explanation" value="Наука перечисляется среди элементов духовной культуры." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4db;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="1050" height="99" as="geometry"/></mxCell><mxCell id="difficulty" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf9ed;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="517" width="1050" height="47" as="geometry"/></mxCell><mxCell id="reference" value="4 курс ТЕМА 3апологетика.docx — §3.2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2eff9;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="577" width="1050" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.2.1.2" name="3.2.1.2"><mxGraphModel dx="1280" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="question" value="Какой пример наиболее непосредственно относится к материальной культуре?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1050" height="82" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ Орудия труда и технические средства" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_2" value="Правовые нормы и общественные институты" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_3" value="Мировоззренческие концепции и теории" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="1050" height="67" as="geometry"/></mxCell><mxCell id="explanation" value="Материальная культура определена как система вещественно-энергетических средств бытия." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4db;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="1050" height="99" as="geometry"/></mxCell><mxCell id="difficulty" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf9ed;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="517" width="1050" height="47" as="geometry"/></mxCell><mxCell id="reference" value="4 курс ТЕМА 3апологетика.docx — §3.2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2eff9;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="577" width="1050" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.2.1.3" name="3.2.1.3"><mxGraphModel dx="1280" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="question" value="Какие явления относятся к духовной культуре?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1050" height="82" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ Наука" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_2" value="✓ Мировоззрение" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_3" value="✓ Искусство" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_4" value="Социальный этикет" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="1050" height="67" as="geometry"/></mxCell><mxCell id="explanation" value="Наука, мировоззрение и искусство входят в духовную культуру. Этикет в принятой классификации относится к социальной культуре; отдельные явления культуры могут быть связаны между собой." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4db;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="485" width="1050" height="99" as="geometry"/></mxCell><mxCell id="difficulty" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf9ed;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="597" width="1050" height="47" as="geometry"/></mxCell><mxCell id="reference" value="4 курс ТЕМА 3апологетика.docx — §3.2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2eff9;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="657" width="1050" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.3.1.1" name="3.3.1.1"><mxGraphModel dx="1280" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="question" value="Как святитель Лука (Войно-Ясенецкий) определял науку?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1050" height="82" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ Система достигнутых и развивающихся знаний и гипотез о наблюдаемых явлениях действительности" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_2" value="Система методов установления повторяющихся зависимостей в природе и обществе" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_3" value="Деятельность по созданию объективных и системно организованных знаний о мире" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="1050" height="67" as="geometry"/></mxCell><mxCell id="explanation" value="Первый вариант соответствует определению святителя Луки, приведённому в §3.3; другие варианты близки к распространённым определениям науки, но не воспроизводят его формулу." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4db;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="1050" height="99" as="geometry"/></mxCell><mxCell id="difficulty" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf9ed;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="517" width="1050" height="47" as="geometry"/></mxCell><mxCell id="reference" value="4 курс ТЕМА 3апологетика.docx — §3.3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2eff9;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="577" width="1050" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.3.1.2" name="3.3.1.2"><mxGraphModel dx="1280" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="question" value="Кто является субъектом научной деятельности?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1050" height="82" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ Исследователь и научное сообщество" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_2" value="Исследуемые природные и социальные явления" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_3" value="Методы, приборы и экспериментальные установки" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="1050" height="67" as="geometry"/></mxCell><mxCell id="explanation" value="Субъектами названы учёные, коллективы и человечество, осуществляющие познавательную деятельность." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4db;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="1050" height="99" as="geometry"/></mxCell><mxCell id="difficulty" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf9ed;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="517" width="1050" height="47" as="geometry"/></mxCell><mxCell id="reference" value="4 курс ТЕМА 3апологетика.docx — §3.3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2eff9;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="577" width="1050" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.3.1.3" name="3.3.1.3"><mxGraphModel dx="1280" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="question" value="Какие из перечисленных образований являются формами научного знания?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1050" height="82" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ Научный факт" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_2" value="✓ Гипотеза" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_3" value="✓ Теория" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_4" value="Исследовательская методика" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="1050" height="67" as="geometry"/></mxCell><mxCell id="explanation" value="Факт, гипотеза и теория — формы научного знания; методика относится к способам и процедурам научной деятельности." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4db;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="485" width="1050" height="99" as="geometry"/></mxCell><mxCell id="difficulty" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf9ed;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="597" width="1050" height="47" as="geometry"/></mxCell><mxCell id="reference" value="4 курс ТЕМА 3апологетика.docx — §3.3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2eff9;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="657" width="1050" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.4.1.1" name="3.4.1.1"><mxGraphModel dx="1280" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="question" value="Какие группы знания выделял Аристотель?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#8aa2b9;fontSi