" height="82" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ Анализ и синтез" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_2" value="✓ Индукция и дедукция" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_3" value="Абстрагирование и измерение" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="1050" height="67" as="geometry"/></mxCell><mxCell id="explanation" value="Анализ дополняется синтезом, индукция — дедукцией. Абстрагирование и измерение могут сочетаться в исследовании, но не образуют такую парную логическую операцию." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4db;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="1050" height="99" as="geometry"/></mxCell><mxCell id="difficulty" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf9ed;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="517" width="1050" height="47" as="geometry"/></mxCell><mxCell id="reference" value="4 курс ТЕМА 3апологетика.docx — §3.9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2eff9;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="577" width="1050" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.9.1.4" name="3.9.1.4"><mxGraphModel dx="1280" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="question" value="В чём состоит метод идеализации?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1050" height="82" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ В мысленном построении объекта с заданными идеальными свойствами" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_2" value="В мысленном выделении существенного свойства при отвлечении от остальных" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_3" value="В переводе содержательного утверждения на язык символов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="1050" height="67" as="geometry"/></mxCell><mxCell id="explanation" value="Первое описывает идеализацию (например, материальную точку); второе — абстрагирование, третье — формализацию." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4db;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="1050" height="99" as="geometry"/></mxCell><mxCell id="difficulty" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf9ed;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="517" width="1050" height="47" as="geometry"/></mxCell><mxCell id="reference" value="4 курс ТЕМА 3апологетика.docx — §3.9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2eff9;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="577" width="1050" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.10.1.1" name="3.10.1.1"><mxGraphModel dx="1280" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="question" value="Какие обстоятельства ограничивают возможности научного познания?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1050" height="82" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ Конечность человеческого опыта" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_2" value="✓ Ограниченность восприятия и мышления" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_3" value="✓ Воздействие культурных и социальных установок" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_4" value="Наличие многообразных методов исследования" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="1050" height="67" as="geometry"/></mxCell><mxCell id="explanation" value="Многообразие методов является особенностью науки и может помогать преодолевать ограничения, тогда как первые три фактора в §3.10 названы источниками ограничений." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4db;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="485" width="1050" height="99" as="geometry"/></mxCell><mxCell id="difficulty" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf9ed;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="597" width="1050" height="47" as="geometry"/></mxCell><mxCell id="reference" value="4 курс ТЕМА 3апологетика.docx — §3.10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2eff9;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="657" width="1050" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.10.1.2" name="3.10.1.2"><mxGraphModel dx="1280" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="question" value="Какова роль научного метода в познании и практической деятельности?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1050" height="82" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ Он служит инструментом, результаты применения которого зависят также от целей человека" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_2" value="Он определяет нравственную оценку целей исследования" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_3" value="Он заменяет необходимость мировоззренческого обсуждения результатов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="1050" height="67" as="geometry"/></mxCell><mxCell id="explanation" value="Текст подчёркивает инструментальный характер метода и ответственность за его применение." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4db;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="1050" height="99" as="geometry"/></mxCell><mxCell id="difficulty" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf9ed;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="517" width="1050" height="47" as="geometry"/></mxCell><mxCell id="reference" value="4 курс ТЕМА 3апологетика.docx — §3.10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2eff9;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="577" width="1050" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.11.1.1" name="3.11.1.1"><mxGraphModel dx="1280" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="question" value="Что показывает мысленный пример Эйнштейна с закрытыми часами?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1050" height="82" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ Одни наблюдения могут допускать несколько объясняющих моделей" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_2" value="Достоверность модели определяется точностью приборных измерений" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_3" value="Успешное предсказание делает выбранную модель единственным возможным объяснением" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="1050" height="67" as="geometry"/></mxCell><mxCell id="explanation" value="Образ закрытых часов подчёркивает неоднозначность интерпретации наблюдаемого." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4db;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="1050" height="99" as="geometry"/></mxCell><mxCell id="difficulty" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf9ed;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="517" width="1050" height="47" as="geometry"/></mxCell><mxCell id="reference" value="4 курс ТЕМА 3апологетика.docx — §3.11" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2eff9;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="577" width="1050" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.11.1.2" name="3.11.1.2"><mxGraphModel dx="1280" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="question" value="Для чего, по мысли Ричарда Фейнмана, научное исследование выдвигает предположения?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1050" height="82" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ Чтобы объяснять и предсказывать явления за пределами непосредственно наблюдавшегося" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_2" value="Чтобы преобразовывать результаты измерений в единую систему единиц" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_3" value="Чтобы переходить от теоретических построений к регистрации готовых фактов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="1050" height="67" as="geometry"/></mxCell><mxCell id="explanation" value="Фейнман связывает научные предположения с выходом за пределы непосредственно наблюдавшегося." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4db;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="1050" height="99" as="geometry"/></mxCell><mxCell id="difficulty" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf9ed;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="517" width="1050" height="47" as="geometry"/></mxCell><mxCell id="reference" value="4 курс ТЕМА 3апологетика.docx — §3.11" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2eff9;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="577" width="1050" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.11.1.3" name="3.11.1.3"><mxGraphModel dx="1280" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="question" value="Какой пример демонстрирует историческое уточнение границ применимости научной теории?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1050" height="82" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ Переход от классической механики Ньютона к более общей релятивистской картине" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_2" value="Развитие экспериментальной техники при сохранении исходной модели без изменений" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_3" value="Смена терминологии в описании одного и того же эмпирического результата" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="1050" height="67" as="geometry"/></mxCell><mxCell id="explanation" value="В разделе 3.11 рассмотрен пересмотр границ применимости ньютоновской механики." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4db;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="1050" height="99" as="geometry"/></mxCell><mxCell id="difficulty" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf9ed;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="517" width="1050" height="47" as="geometry"/></mxCell><mxCell i