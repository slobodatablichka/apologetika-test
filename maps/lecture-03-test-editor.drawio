енения" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_3" value="Исследование ценностей, норм и смыслов человеческой культуры" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="1050" height="67" as="geometry"/></mxCell><mxCell id="explanation" value="Технические науки связаны с созданием и функционированием технических устройств." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4db;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="1050" height="99" as="geometry"/></mxCell><mxCell id="difficulty" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf9ed;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="517" width="1050" height="47" as="geometry"/></mxCell><mxCell id="reference" value="4 курс ТЕМА 3апологетика.docx — §3.5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2eff9;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="577" width="1050" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.5.1.3" name="3.5.1.3"><mxGraphModel dx="1280" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="question" value="Какая группа наук исследует человека в единстве его природных и общественных характеристик?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1050" height="82" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ Антропологические" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_2" value="Общественные" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_3" value="Естественные" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="1050" height="67" as="geometry"/></mxCell><mxCell id="explanation" value="В классификации §3.5 антропологические науки объединяют изучение природных и общественных свойств человека; общественные науки акцентируют устройство общества." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4db;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="1050" height="99" as="geometry"/></mxCell><mxCell id="difficulty" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf9ed;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="517" width="1050" height="47" as="geometry"/></mxCell><mxCell id="reference" value="4 курс ТЕМА 3апологетика.docx — §3.5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2eff9;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="577" width="1050" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.6.1.1" name="3.6.1.1"><mxGraphModel dx="1280" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="question" value="Какие положения выступают исходными предпосылками естественнонаучного познания?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1050" height="82" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ Независимое от исследователя существование внешнего мира" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_2" value="✓ Закономерность и познаваемость природы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_3" value="Принцип обязательной экспериментальной проверки каждой математической аксиомы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_4" value="Предпочтение простейшей теории при одинаковой объяснительной силе" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="1050" height="67" as="geometry"/></mxCell><mxCell id="explanation" value="В §3.6 выделены объективная реальность мира и его закономерная познаваемость. Два иных положения связаны с обоснованием или выбором методов, но не составляют названную пару предпосылок." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4db;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="485" width="1050" height="99" as="geometry"/></mxCell><mxCell id="difficulty" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf9ed;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="597" width="1050" height="47" as="geometry"/></mxCell><mxCell id="reference" value="4 курс ТЕМА 3апологетика.docx — §3.6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2eff9;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="657" width="1050" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.6.1.2" name="3.6.1.2"><mxGraphModel dx="1280" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="question" value="Какова методологическая роль исходных постулатов естествознания?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1050" height="82" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ Они задают предпосылки, принимаемые для построения исследований" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_2" value="Они фиксируют обобщения, полученные из завершённых экспериментов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_3" value="Они задают способы числовой обработки результатов наблюдений" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="1050" height="67" as="geometry"/></mxCell><mxCell id="explanation" value="Лекция отличает исходные предпосылки от конкретных результатов наблюдения." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4db;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="1050" height="99" as="geometry"/></mxCell><mxCell id="difficulty" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf9ed;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="517" width="1050" height="47" as="geometry"/></mxCell><mxCell id="reference" value="4 курс ТЕМА 3апологетика.docx — §3.6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2eff9;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="577" width="1050" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.6.1.3" name="3.6.1.3"><mxGraphModel dx="1280" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="question" value="Какая пара описаний демонстрирует использование взаимодополняющих физических моделей одного объекта?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1050" height="82" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ Волновое и корпускулярное описание света" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_2" value="Классическая механика и термодинамика" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_3" value="Ботаническая и зоологическая классификация организмов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="1050" height="67" as="geometry"/></mxCell><mxCell id="explanation" value="В разделе 3.6 используются две модели описания света." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4db;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="1050" height="99" as="geometry"/></mxCell><mxCell id="difficulty" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf9ed;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="517" width="1050" height="47" as="geometry"/></mxCell><mxCell id="reference" value="4 курс ТЕМА 3апологетика.docx — §3.6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2eff9;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="577" width="1050" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.7.1.1" name="3.7.1.1"><mxGraphModel dx="1280" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="question" value="Какая дисциплина занимается исследованием методов научного познания?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1050" height="82" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ Методология" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_2" value="Логика" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_3" value="Эпистемология" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="1050" height="67" as="geometry"/></mxCell><mxCell id="explanation" value="Методология специально изучает методы и способы познания; логика — формы и правила вывода, эпистемология — знание и его обоснование в более широком смысле." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4db;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="1050" height="99" as="geometry"/></mxCell><mxCell id="difficulty" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf9ed;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="517" width="1050" height="47" as="geometry"/></mxCell><mxCell id="reference" value="4 курс ТЕМА 3апологетика.docx — §3.7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2eff9;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="577" width="1050" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.7.1.2" name="3.7.1.2"><mxGraphModel dx="1280" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="question" value="Какие основные уровни научного познания выделяются?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1050" height="82" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ Эмпирический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_2" value="✓ Теоретический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_3" value="Методологический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="1050" height="67" as="geometry"/></mxCell><mxCell id="explanation" value="Методологический анализ возможен на обоих уровнях, но здесь уровни научного познания — эмпирический и теоретический." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4db;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="1050" height="99" as="geometry"/></mxCell><mxCell id="difficulty" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf9ed;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="517" width="1050" height="47" as="geometry"/></mxCell><mxCell id="reference" value="4 курс ТЕМА 3апологетика.docx — §3.7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2eff9;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="577" width="1050" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.7.1.3" name="3.7.1.3"><mxGraphModel dx="1280" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="question" value="Какие методы непосредственно используются для получения эмпирических данных?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1050" height="82" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ Наблюдение" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_2" value="✓ Измерение" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_3" value="✓ Эксперимент" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_4" value="Мысленный эксперимент" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="1050" height="67" as="geometry"/></mxCell><mxCell id="explanation" value="Мысленный эксперимент — теоретическая операция, в отличие от наблюдения, измерения и реального эксперимента." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4db;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="485" width="1050" height="99" as="geometry"/></mxCell><mxCell id="difficulty" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf9ed;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="597" width="1050" height="47" as="geometry"/></mxCell><mxCell id="reference" value="4 курс ТЕМА 3апологетика.docx — §3.7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2eff9;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="657" width="1050" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3.8.1.1" name="3.8.1.1"><mxGraphModel dx="1280" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1140" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="question" value="Какие признаки характерны для научного наблюдения?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f2fb;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1050" height="82" as="geometry"/></mxCell><mxCell id="choice_1" value="✓ Целенаправленность" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_2" value="✓ Планомерность" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_3" value="✓ Активность исследователя" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="325" width="1050" height="67" as="geometry"/></mxCell><mxCell id="choice_4" value="Преобразование объекта в искусственных условиях" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fc;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="405" width="1050" height="67" as="geometry"/></mxCell><mxCell id="explanation" value="Контролируемое преобразование условий характернее для эксперимента; научное наблюдение целенаправленно, планомерно и предполагает активную работу исследователя." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4db;strokeColor=#8aa2b9;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="4