атические" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;fontSize=18;fillColor=#ffffff;strokeColor=#93a8bc;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="24" y="555" width="1050" height="69" as="geometry"/></mxCell><mxCell id="explanation" value="К шести типам также относятся психологические и структурные, но не климатические." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;fontSize=18;fillColor=#edf3f8;strokeColor=#93a8bc;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="24" y="639" width="1050" height="114" as="geometry"/></mxCell><mxCell id="difficulty" value="3" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;fontSize=18;fillColor=#fff8e8;strokeColor=#93a8bc;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="24" y="768" width="1050" height="58" as="geometry"/></mxCell><mxCell id="reference" value="19–32" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;fontSize=18;fillColor=#fff8e8;strokeColor=#93a8bc;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="24" y="841" width="1050" height="58" as="geometry"/></mxCell><mxCell id="note" value="✓ отмечает правильные ответы. Дважды щёлкните по полю, чтобы изменить его. При изменении количества ответов сообщите мне." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;fontSize=18;fillColor=#f3f4f6;strokeColor=#93a8bc;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="24" y="914" width="1050" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="question-1-2-2-1" name="1.2.2.1"><mxGraphModel page="1" pageWidth="1120" pageHeight="960" grid="1" gridSize="10"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="header" value="ЛЕКЦИЯ 1 · ВОПРОС 1.2.2.1 · БЛОК 1.2.2" style="rounded=1;whiteSpace=wrap;ht