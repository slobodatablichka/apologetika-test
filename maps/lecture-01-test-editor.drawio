." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;fontSize=18;fillColor=#edf3f8;strokeColor=#93a8bc;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="24" y="555" width="1050" height="114" as="geometry"/></mxCell><mxCell id="difficulty" value="3" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;fontSize=18;fillColor=#fff8e8;strokeColor=#93a8bc;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="24" y="684" width="1050" height="58" as="geometry"/></mxCell><mxCell id="reference" value="82, 86–88" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;fontSize=18;fillColor=#fff8e8;strokeColor=#93a8bc;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="24" y="757" width="1050" height="58" as="geometry"/></mxCell><mxCell id="note" value="✓ отмечает правильные ответы. Дважды щёлкните по полю, чтобы изменить его. При изменении количества ответов сообщите мне." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;fontSize=18;fillColor=#f3f4f6;strokeColor=#93a8bc;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="24" y="830" width="1050" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="question-1-7-2-3" name="1.7.2.3"><mxGraphModel page="1" pageWidth="1120" pageHeight="876" grid="1" gridSize="10"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="header" value="ЛЕКЦИЯ 1 · ВОПРОС 1.7.2.3 · БЛОК 1.7.2" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;fontSize=18;fillColor=#dce9f6;strokeColor=#93a8bc;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="24" y="22" width="1050" height="62" as="geometry"/></mxCell><mxCell id="question" value="Какое сопоставление религиозно-философских систем верно?" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=mid