<mxfile host="app.diagrams.net"><diagram id="material15" name="Смысловая карта теста 15"><mxGraphModel page="1" pageWidth="1550" pageHeight="1600"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="Полемика 2007 года" style="rounded=1;whiteSpace=wrap;fillColor=#daeafa;strokeColor=#889aab;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="25" width="300" height="110" as="geometry"/></mxCell><mxCell id="v2" value="«Письмо десяти» → критика статуса теологии и обязательности ОПК" style="rounded=1;whiteSpace=wrap;fillColor=#edf5ed;strokeColor=#889aab;spacing=8;" vertex="1" parent="1"><mxGeometry x="355" y="25" width="440" height="110" as="geometry"/></mxCell><mxCell id="v3" value="Ответное письмо → гуманитарная специфика теологии; европейская университетская практика" style="rounded=1;whiteSpace=wrap;fillColor=#edf5ed;strokeColor=#889aab;spacing=8;" vertex="1" parent="1"><mxGeometry x="830" y="25" width="440" height="110" as="geometry"/></mxCell><mxCell id="edge0_1" value="основание" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;" edge="1" parent="1" source="v1" target="v2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge0_2" value="следствие" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;" edge="1" parent="1" source="v2" target="v3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v4" value="Общественная дискуссия 2008 года" style="rounded=1;whiteSpace=wrap;fillColor=#daeafa;strokeColor=#889aab;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="300" height="110" as="geometry"/></mxCell><mxCell id="v5" value="225 исследователей → поддержка теологии и ОПК" style="rounded=1;whiteSpace=wrap;fillColor=#edf5ed;strokeColor=#889aab;spacing=8;" vertex="1" parent="1"><mxGeometry x="355" y="200" width="440" height="110" as="geometry"/></mxCell><mxCell id="v6" value="1700+ подписантов → критика ОПК и письма 225; числа ≠ репрезентативный опрос" style="rounded=1;whiteSpace=wrap;fillColor=#edf5ed;strok