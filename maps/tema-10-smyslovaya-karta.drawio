<mxfile host="app.diagrams.net"><diagram name="Смысловая карта лекции 10"><mxGraphModel page="1" pageWidth="1050" pageHeight="1400"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v0" value="Природа чуда → совершенство творения и Промысл" style="rounded=1;whiteSpace=wrap;fillColor=#e7f0f8;strokeColor=#849dac;" vertex="1" parent="1"><mxGeometry x="20" y="30" width="420" height="140" as="geometry"/></mxCell><mxCell id="v1" value="Определение → редкость недостаточна; событие и закон" style="rounded=1;whiteSpace=wrap;fillColor=#e7f0f8;strokeColor=#849dac;" vertex="1" parent="1"><mxGeometry x="480" y="30" width="420" height="140" as="geometry"/></mxCell><mxCell id="e1" value="аргумент" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;" edge="1" parent="1" source="v0" target="v1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v2" value="Лейбниц → нарушение закона; Льюис → иная комбинация" style="rounded=1;whiteSpace=wrap;fillColor=#e7f0f8;strokeColor=#849dac;" vertex="1" parent="1"><mxGeometry x="20" y="270" width="420" height="140" as="geometry"/></mxCell><mxCell id="e2" value="аргумент" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;" edge="1" parent="1" source="v1" target="v2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3" value="Возможность → личный Бог и свободная воля" style="rounded=1;whiteSpace=wrap;fillColor=#e7f0f8;strokeColor=#849dac;" vertex="1" parent="1"><mxGeometry x="480" y="270" width="420" height="140" as="geometry"/></mxCell><mxCell id="e3" value="аргумент" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;" edge="1" parent="1" source="v2" target="v3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v4" value="Возражения → пантеизм Спинозы и скепсис Юма" style="rounded=1;whiteSpace=wrap;fillColor=#e7f0f8;strokeColor=#849dac;" vertex="1" parent="1"><mxGeometry x="20" y="510" width="420" height="140" as="geometry"/></mxCell><mxCell id="e4" value="аргумент" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;" edge="1" parent="1" source="v3" target="v4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v5" value="Жизнь как чудо → обычный порядок и энтропия" style="rounded=1;whiteSpace=wrap;fillColor=#e7f0f8;strokeColor=#849dac;" vertex="1" parent="1"><mxGeometry x="480" y="510" width="420" height="140" as="geometry"/></mxCell><mxCell id="e5" value="аргумент" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;" edge="1" parent="1" source="v4" target="v5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v6" value="Вера → свободное признание, не принуждение" style="rounded=1;whiteSpace=wrap;fillColor=#e7f0f8;strokeColor=#849dac;" vertex="1" parent="1"><mxGeometry x="20" y="750" width="420" height="140" as="geometry"/></mxCell><mxCell id="e6" value="аргумент" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;" edge="1" parent="1" source="v5" target="v6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v7" value="Различение → истинное спасительное и ложное обольщающее" style="rounded=1;whiteSpace=wrap;fillColor=#e7f0f8;strokeColor=#849dac;" vertex="1" parent="1"><mxGeometry x="480" y="750" width="420" height="140" as="geometry"/></mxCell><mxCell id="e7" value="аргумент" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;" edge="1" parent="1" source="v6" target="v7"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>